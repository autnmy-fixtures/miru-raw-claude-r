#!/usr/bin/env bash
# Drives the Timekeeping local demo runtime (docker-compose.timekeeping-demo.yml;
# docs/architecture/timekeeping-soa.md §11.1, §11.2). See
# services/timekeeping/README.md, "The local demo runtime".
#
#   bin/timekeeping-demo init        write the demo's credentials, once
#   bin/timekeeping-demo up          build both images; start both applications
#                                    and only their dedicated workers
#   bin/timekeeping-demo rebuild timekeeping|existing
#                                    rebuild and restart one application; the
#                                    other stays at the artifact it runs
#   bin/timekeeping-demo versions    the revision and image each process runs
#   bin/timekeeping-demo handoff first_cutover|rollback|recutover[:abort]
#                                    run a handoff runner in the existing app
#   bin/timekeeping-demo journey     the end-to-end journey (§13 item 1), from a
#                                    freshly seeded demo, in the existing app
#   bin/timekeeping-demo alternating-writers
#                                    every writer across cutover, rollback and
#                                    re-cutover (§12.4), from a freshly seeded
#                                    demo, in the existing app
#   bin/timekeeping-demo contract-check
#                                    every contract between the two running
#                                    apps, while Timekeeping owns the entries
#   bin/timekeeping-demo independent-deploys
#                                    the independent-deployment proof (§13
#                                    item 4): rebuild and restart Timekeeping,
#                                    then the existing app, each alone, with the
#                                    contract check after each; recorded under
#                                    tmp/timekeeping-demo/deploys
#   bin/timekeeping-demo relay-paused
#                                    the relay-paused proof (§13 item 5): stop
#                                    Timekeeping's relay, list and invoice a new
#                                    entry at once, start the relay again, and
#                                    see the projection catch up
#   bin/timekeeping-demo user-delete-refused
#                                    the user-hard-delete proof (§12.4): stop
#                                    the current owner's relay, see the
#                                    super-admin delete of a user with a first,
#                                    unprojected entry refused, start the relay
#                                    again, and see the entry projected; run it
#                                    after a cutover and after a rollback
#   bin/timekeeping-demo down        stop everything; the databases are kept
#   bin/timekeeping-demo compose …   any other docker compose command
#
# Credentials are read from TIMEKEEPING_DEMO_ENV_FILE
# (tmp/timekeeping-demo/demo.env by default, ignored by git, mode 0600). They
# never sit in a checked-in file (§11.2).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${ROOT}/docker-compose.timekeeping-demo.yml"
ENV_FILE="${TIMEKEEPING_DEMO_ENV_FILE:-${ROOT}/tmp/timekeeping-demo/demo.env}"
# Where independent-deploys keeps its records: next to the credentials.
RECORD_DIR="${TIMEKEEPING_DEMO_RECORD_DIR:-$(dirname "${ENV_FILE}")/deploys}"

EXISTING_SERVICES=(miru-web miru-jobs)
TIMEKEEPING_SERVICES=(timekeeping-web timekeeping-relay)

# Where each application's image holds the contract documents (§5) it reads.
EXISTING_CONTRACTS=/rails/packages/timekeeping_reservations/contracts/v1
TIMEKEEPING_CONTRACTS=/app/packages/timekeeping_reservations/contracts/v1

usage() {
  # The comment block at the top of this file, up to its first code line.
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

die() {
  echo "timekeeping-demo: $*" >&2
  exit 1
}

secret() {
  od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n'
}

# The revision an image is built from: the commit, marked dirty when the
# working tree differs from it, so a recorded version says what was built.
revision() {
  local sha
  sha="$(git -C "${ROOT}" rev-parse HEAD 2>/dev/null)" || { echo unknown; return; }
  if ! git -C "${ROOT}" diff --quiet HEAD -- 2>/dev/null; then
    sha="${sha}-dirty"
  fi
  echo "${sha}"
}

require_env_file() {
  [ -f "${ENV_FILE}" ] || die "no credentials at ${ENV_FILE}; run bin/timekeeping-demo init first"
}

compose() {
  require_env_file
  docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" "$@"
}

cmd_init() {
  if [ -e "${ENV_FILE}" ]; then
    echo "Credentials already at ${ENV_FILE}; left as they are."
    return
  fi
  mkdir -p "$(dirname "${ENV_FILE}")"
  (
    umask 077
    {
      echo "# The Timekeeping local demo's credentials (bin/timekeeping-demo init)."
      echo "# Each application has its own database credential; only the token key is shared."
      echo "MIRU_DB_PASSWORD=$(secret 24)"
      echo "MIRU_SECRET_KEY_BASE=$(secret 64)"
      echo "# The seeded users' password: sign in to the existing application with it."
      echo "MIRU_SEED_PASSWORD=$(secret 16)"
      echo "TIMEKEEPING_DB_PASSWORD=$(secret 24)"
      echo "TIMEKEEPING_SECRET_KEY_BASE=$(secret 64)"
      echo "TIMEKEEPING_TOKEN_KEY=$(secret 32)"
    } > "${ENV_FILE}"
  )
  echo "Wrote the demo's credentials to ${ENV_FILE}."
}

build() {
  local rev
  rev="$(revision)"
  MIRU_REVISION="${rev}" TIMEKEEPING_REVISION="${rev}" compose build "$@"
}

cmd_up() {
  build miru-web timekeeping-web
  compose up --detach --wait "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}"
  cmd_versions
}

# Rebuilds one application's image and restarts its processes on it, leaving
# the other application's containers, and the artifact they run, untouched
# (§11.2, §13 item 4). The web process comes back healthy before its worker.
cmd_rebuild() {
  local web worker
  case "${1:-}" in
    timekeeping) web=timekeeping-web; worker=timekeeping-relay ;;
    existing) web=miru-web; worker=miru-jobs ;;
    *) die "rebuild takes timekeeping or existing" ;;
  esac
  build "${web}"
  compose up --detach --wait --no-deps --force-recreate "${web}"
  compose up --detach --wait --no-deps --force-recreate "${worker}"
  cmd_versions
}

# "<container id> <image id> <revision>" for a service's running process, or
# nothing when it is not running. Each container is inspected by its name,
# and each --format given as one argument.
process_state() {
  local name container image rev
  name="$(compose ps --format '{{.Name}}' "$1")"
  [ -n "${name}" ] || return 0
  container="$(docker inspect --format='{{.Id}}' "${name}")"
  image="$(docker inspect --format='{{.Image}}' "${name}")"
  rev="$(docker image inspect --format='{{index .Config.Labels "org.opencontainers.image.revision"}}' "${image}")"
  echo "${container} ${image} ${rev}"
}

cmd_versions() {
  local service container image rev
  for service in "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}"; do
    read -r container image rev <<< "$(process_state "${service}")"
    if [ -z "${container}" ]; then
      echo "${service} not running"
      continue
    fi
    echo "${service} revision=${rev} image=${image}"
  done
}

# One line per running process: its container, the image it runs and the
# revision that image was built from. Fails when a process is not running.
processes() {
  local service container image rev
  for service in "$@"; do
    read -r container image rev <<< "$(process_state "${service}")"
    [ -n "${container}" ] || die "${service} is not running; start the demo with bin/timekeeping-demo up"
    echo "${service} container=${container} image=${image} revision=${rev}"
  done
}

# The digest of every contract document a running process reads.
contract_digests() {
  compose exec -T "$1" sh -c "cd '$2' && sha256sum *.json"
}

# The contract check of §13 item 4: both running applications read the same
# contract documents, byte for byte, and every contract holds between them
# (bin/rails timekeeping:contract_check, Timekeeping::ContractCheck).
cmd_contract_check() {
  local existing timekeeping
  existing="$(contract_digests miru-web "${EXISTING_CONTRACTS}")"
  timekeeping="$(contract_digests timekeeping-web "${TIMEKEEPING_CONTRACTS}")"
  if [ -z "${existing}" ] || [ "${existing}" != "${timekeeping}" ]; then
    die "$(printf 'the two applications do not read the same contract documents\nexisting application:\n%s\nTimekeeping:\n%s' "${existing}" "${timekeeping}")"
  fi
  echo "contract documents: both applications read the same $(echo "${existing}" | wc -l | tr -d ' ') files"
  compose exec -T miru-web bin/rails timekeeping:contract_check
}

# One deploy of the independent-deployment proof: rebuild and restart one
# application, then prove the other still runs the containers and images it
# ran before, that each of this one's processes was restarted, and that the
# contract check holds.
deploy() {
  local name="$1" other_name before_other after_other before after service
  local -a services others
  case "${name}" in
    timekeeping) services=("${TIMEKEEPING_SERVICES[@]}"); others=("${EXISTING_SERVICES[@]}"); other_name="the existing application" ;;
    existing) services=("${EXISTING_SERVICES[@]}"); others=("${TIMEKEEPING_SERVICES[@]}"); other_name="Timekeeping" ;;
  esac
  echo "== deploy: ${name}, alone ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
  before_other="$(processes "${others[@]}")"
  before="$(processes "${services[@]}")"
  cmd_rebuild "${name}"
  after_other="$(processes "${others[@]}")"
  if [ "${before_other}" != "${after_other}" ]; then
    die "$(printf 'rebuilding %s changed %s\nbefore:\n%s\nafter:\n%s' "${name}" "${other_name}" "${before_other}" "${after_other}")"
  fi
  after="$(processes "${services[@]}")"
  for service in "${services[@]}"; do
    if [ "$(grep "^${service} " <<< "${before}" | cut -d' ' -f2)" = "$(grep "^${service} " <<< "${after}" | cut -d' ' -f2)" ]; then
      die "${service} was not restarted"
    fi
  done
  echo "${name} now runs:"
  echo "${after}"
  echo "${other_name} stayed at its prior artifact:"
  echo "${after_other}"
  cmd_contract_check
}

# The independent-deployment proof of §13 item 4 (§11.2): no paired release.
# The contract check holds first; then Timekeeping is rebuilt and restarted
# while the existing application stays at its prior artifact, and the check
# holds again; then the existing application while Timekeeping stays
# unchanged, and the check holds again. Every version is recorded.
independent_deploys() {
  echo "== before the deploys ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}"
  cmd_contract_check
  deploy timekeeping
  deploy existing
  echo "== independent deploys done: two deploys, one of each application, the contract check green after each"
}

cmd_independent_deploys() {
  local record status
  require_env_file
  mkdir -p "${RECORD_DIR}"
  record="${RECORD_DIR}/$(date -u +%Y%m%dT%H%M%SZ).log"
  # Not as an `if` condition, which would turn off errexit inside it: the
  # first step that fails must end the proof.
  set +e
  (set -e; independent_deploys) 2>&1 | tee "${record}"
  status=$?
  set -e
  echo "Recorded in ${record}."
  return "${status}"
}

# Starts Timekeeping's relay again, and shows it runs.
resume_relay() {
  echo "== resuming Timekeeping's relay"
  compose start timekeeping-relay
  processes timekeeping-relay
}

# The relay-paused proof of §13 item 5 (§12.4), while Timekeeping owns the
# entries: with timekeeping-relay stopped, a new entry is listed and invoiced
# at once and is not projected (bin/rails timekeeping:relay_paused:paused);
# with it started again, the projection catches up
# (timekeeping:relay_paused:resumed). Both halves run in the existing
# application under one run name. The relay is started again however the
# first half ends.
cmd_relay_paused() {
  local run
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  echo "== pausing Timekeeping's relay: run ${run}"
  trap resume_relay EXIT
  compose stop timekeeping-relay
  [ -z "$(process_state timekeeping-relay)" ] || die "timekeeping-relay still runs after it was stopped"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:relay_paused:paused
  trap - EXIT
  resume_relay
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:relay_paused:resumed
  echo "== relay paused: a new entry was listed and invoiced before the relay delivered it, and the projection caught up once it resumed"
}

# Starts a stopped relay's service again, and shows it runs.
resume_service() {
  echo "== resuming $1"
  compose start "$1"
  processes "$1"
}

# The user-hard-delete proof of §12.4, while Timekeeping or the prepared
# application owns the entries: the existing application names the service
# that runs the current owner's relay (timekeeping-relay, or miru-jobs for
# the prepared application's local relay;
# bin/rails timekeeping:user_delete_refused:relay). With it stopped, the
# super-admin delete of a user whose first entry is not yet projected is
# refused with nothing changed (timekeeping:user_delete_refused:paused); with
# it started again, the entry is projected
# (timekeeping:user_delete_refused:resumed). All three run in miru-web under
# one run name. The relay is started again however the first half ends.
cmd_user_delete_refused() {
  local run relay
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  relay="$(compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:user_delete_refused:relay | tail -n 1)"
  case "${relay}" in
    timekeeping-relay|miru-jobs) ;;
    *) die "the existing application named no relay to pause: ${relay:-nothing}" ;;
  esac
  echo "== pausing the owner's relay (${relay}): run ${run}"
  # Expanded now: the trap runs after this function, and its locals, are gone.
  trap "resume_service ${relay}" EXIT
  compose stop "${relay}"
  [ -z "$(process_state "${relay}")" ] || die "${relay} still runs after it was stopped"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:user_delete_refused:paused
  trap - EXIT
  resume_service "${relay}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:user_delete_refused:resumed
  echo "== user delete refused: the super-admin delete of a user with an unprojected first entry was refused, and the entry was projected once ${relay} resumed"
}

cmd_handoff() {
  case "${1:-}" in
    first_cutover|first_cutover:abort|rollback|rollback:abort|recutover|recutover:abort) ;;
    *) die "handoff takes first_cutover, rollback or recutover, each with an optional :abort" ;;
  esac
  compose exec miru-web bin/rails "timekeeping:$1"
}

cmd_journey() {
  compose exec miru-web bin/rails timekeeping:journey
}

cmd_alternating_writers() {
  compose exec miru-web bin/rails timekeeping:alternating_writers
}

case "${1:-}" in
  init) cmd_init ;;
  up) cmd_up ;;
  rebuild) shift; cmd_rebuild "$@" ;;
  versions) cmd_versions ;;
  handoff) shift; cmd_handoff "$@" ;;
  journey) cmd_journey ;;
  alternating-writers) cmd_alternating_writers ;;
  contract-check) cmd_contract_check ;;
  independent-deploys) cmd_independent_deploys ;;
  relay-paused) cmd_relay_paused ;;
  user-delete-refused) cmd_user_delete_refused ;;
  down) compose down ;;
  compose) shift; compose "$@" ;;
  ""|help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
