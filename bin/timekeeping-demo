#!/usr/bin/env bash
# Drives the Timekeeping local demo runtime (docker-compose.timekeeping-demo.yml;
# docs/architecture/timekeeping-soa.md §11.1, §11.2). See
# services/timekeeping/README.md, "The local demo runtime".
#
#   bin/timekeeping-demo init        write the demo's credentials, once
#   bin/timekeeping-demo up          build both images; start both applications
#                                    and only their dedicated workers
#   bin/timekeeping-demo rebuild timekeeping|existing
#                                    rebuild and restart one application; the
#                                    other stays at the artifact it runs
#   bin/timekeeping-demo versions    the revision and image each process runs
#   bin/timekeeping-demo handoff first_cutover|rollback|recutover[:abort]
#                                    run a handoff runner in the existing app
#   bin/timekeeping-demo journey     the end-to-end journey (§13 item 1), from a
#                                    freshly seeded demo, in the existing app
#   bin/timekeeping-demo alternating-writers
#                                    every writer across cutover, rollback and
#                                    re-cutover (§12.4), from a freshly seeded
#                                    demo, in the existing app
#   bin/timekeeping-demo contract-check
#                                    every contract between the two running
#                                    apps, while Timekeeping owns the entries
#   bin/timekeeping-demo independent-deploys
#                                    the independent-deployment proof (§13
#                                    item 4): rebuild and restart Timekeeping,
#                                    then the existing app, each alone, with the
#                                    contract check after each; recorded under
#                                    tmp/timekeeping-demo/deploys
#   bin/timekeeping-demo relay-paused
#                                    the relay-paused proof (§13 item 5): stop
#                                    Timekeeping's relay, list and invoice a new
#                                    entry at once, start the relay again, and
#                                    see the projection catch up
#   bin/timekeeping-demo user-delete-refused
#                                    the user-hard-delete proof (§12.4): stop
#                                    the current owner's relay, see the
#                                    super-admin delete of a user with a first,
#                                    unprojected entry refused, start the relay
#                                    again, and see the entry projected; run it
#                                    after a cutover and after a rollback
#   bin/timekeeping-demo aggregate-line
#                                    the aggregate-line proof (§12.4, F3): a
#                                    draft's grouped line removed keeps the
#                                    entry its direct line references and
#                                    releases the other; then, with
#                                    timekeeping-web stopped, a save and a
#                                    destroy of the draft fail and keep every
#                                    reservation; with it started again, the
#                                    destroy releases the draft's whole set
#   bin/timekeeping-demo billing-handoff
#                                    the billing-writes-during-a-handoff proof
#                                    (§12.4): pause a billing write inside its
#                                    transaction, start the owner's handoff
#                                    and see its step 1 wait on it; stop
#                                    timekeeping-web so the handoff stops
#                                    after step 1, and see billing writes
#                                    refused with 503 ownership-moving; then
#                                    resume the handoff to its end
#   bin/timekeeping-demo save-failures
#                                    the save-failure part of the failure
#                                    injection (§12.4, §9.3): a lost prepare
#                                    answer, a crash after prepare, a
#                                    rolled-back save, and the replays of a
#                                    committed, an aborted and a forced-pending
#                                    operation, while Timekeeping owns the
#                                    entries
#   bin/timekeeping-demo reservation-failures
#                                    the reservation-protocol part of the
#                                    failure injection (§12.4, §9.3): stop
#                                    miru-jobs, see a wrong-company save and
#                                    two saves behind an unresolved operation
#                                    refused, and every commit and abort
#                                    answer lost; start it again, and see
#                                    every outcome delivered, the resent
#                                    commit change nothing and the retry go
#                                    through
#   bin/timekeeping-demo hard-delete
#                                    the hard-delete-of-a-non-draft part of
#                                    the failure injection (§12.4, §9.3): a
#                                    bulk delete of a sent invoice with a
#                                    payment fails and changes nothing; one
#                                    with none keeps its entry's edit lock,
#                                    retained, until a successor draft takes
#                                    it over; while Timekeeping or the
#                                    prepared application owns the entries
#   bin/timekeeping-demo stale-generation
#                                    the stale-generation part of the failure
#                                    injection (§12.4, §9.3): entry writes and
#                                    reservation calls carrying another
#                                    generation are refused 409
#                                    stale-generation and change nothing, the
#                                    gateway's retry goes through, and
#                                    Timekeeping logs each refusal as an
#                                    alert; while Timekeeping owns the entries
#   bin/timekeeping-demo consumer-down
#                                    the projection-consumer-down part of the
#                                    failure injection (§12.4, §9.3): with
#                                    the consumer down as timekeeping-relay
#                                    meets it and the relay running, an
#                                    edited and a new entry are listed and
#                                    invoiced at once and the projection
#                                    stays as it was, while the relay's
#                                    deliveries are refused; with it back,
#                                    the same relay's resend brings the
#                                    projection to Timekeeping's versions;
#                                    while Timekeeping owns the entries
#   bin/timekeeping-demo redelivery
#                                    the duplicate-and-reordered-delivery
#                                    proof (§13 item 6): with Timekeeping's
#                                    relay stopped after entries changed,
#                                    Timekeeping resends their snapshots
#                                    newest first, then each older one, then
#                                    all again, and the projection applies
#                                    only the newest; with the relay started,
#                                    its second delivery of every one changes
#                                    nothing; while Timekeeping owns the
#                                    entries
#   bin/timekeeping-demo tenant-isolation
#                                    the tenant-isolation proof (§13 item 7):
#                                    neither business can read, write,
#                                    prepare or project the other's entries,
#                                    an employee cannot touch the admin's
#                                    entries, and no process of the existing
#                                    app has logged a single-writer guard
#                                    violation; under any owner with
#                                    admission open
#   bin/timekeeping-demo interrupted-handoff
#                                    the interrupted-and-resumed-handoff
#                                    proof (§13 item 6, §10.5): with the
#                                    relay its transfer waits on stopped, the
#                                    handoff the current owner hands over
#                                    with is killed with SIGKILL in its
#                                    transfer, then run again and stopped
#                                    there for a resume; each time it stays
#                                    fenced and changes nothing, and resumed
#                                    with the relay started it finishes with
#                                    money, entries and reservations kept;
#                                    under any owner with admission open
#   bin/timekeeping-demo ownership   both copies of the ownership record, and
#                                    the owner, generation and state they
#                                    agree on
#   bin/timekeeping-demo reset       delete both databases and the handoff
#                                    journals, and start a freshly seeded demo
#   bin/timekeeping-demo acceptance --reset
#                                    §13 on one local run: three passes, each
#                                    from a reset, running every proof of §13
#                                    and §12.4 under the owner it needs, with
#                                    a summary of each item; recorded under
#                                    tmp/timekeeping-demo/acceptance
#   bin/timekeeping-demo down        stop everything; the databases are kept
#   bin/timekeeping-demo compose …   any other docker compose command
#
# Credentials are read from TIMEKEEPING_DEMO_ENV_FILE
# (tmp/timekeeping-demo/demo.env by default, ignored by git, mode 0600). They
# never sit in a checked-in file (§11.2).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${ROOT}/docker-compose.timekeeping-demo.yml"
ENV_FILE="${TIMEKEEPING_DEMO_ENV_FILE:-${ROOT}/tmp/timekeeping-demo/demo.env}"
# Where independent-deploys keeps its records: next to the credentials.
RECORD_DIR="${TIMEKEEPING_DEMO_RECORD_DIR:-$(dirname "${ENV_FILE}")/deploys}"

EXISTING_SERVICES=(miru-web miru-jobs)
TIMEKEEPING_SERVICES=(timekeeping-web timekeeping-relay)

# Where each application's image holds the contract documents (§5) it reads.
EXISTING_CONTRACTS=/rails/packages/timekeeping_reservations/contracts/v1
TIMEKEEPING_CONTRACTS=/app/packages/timekeeping_reservations/contracts/v1

usage() {
  # The comment block at the top of this file, up to its first code line.
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

die() {
  echo "timekeeping-demo: $*" >&2
  exit 1
}

secret() {
  od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n'
}

# The revision an image is built from: the commit, marked dirty when the
# working tree differs from it, so a recorded version says what was built.
revision() {
  local sha
  sha="$(git -C "${ROOT}" rev-parse HEAD 2>/dev/null)" || { echo unknown; return; }
  if ! git -C "${ROOT}" diff --quiet HEAD -- 2>/dev/null; then
    sha="${sha}-dirty"
  fi
  echo "${sha}"
}

require_env_file() {
  [ -f "${ENV_FILE}" ] || die "no credentials at ${ENV_FILE}; run bin/timekeeping-demo init first"
}

compose() {
  require_env_file
  docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" "$@"
}

cmd_init() {
  if [ -e "${ENV_FILE}" ]; then
    echo "Credentials already at ${ENV_FILE}; left as they are."
    return
  fi
  mkdir -p "$(dirname "${ENV_FILE}")"
  (
    umask 077
    {
      echo "# The Timekeeping local demo's credentials (bin/timekeeping-demo init)."
      echo "# Each application has its own database credential; only the token key is shared."
      echo "MIRU_DB_PASSWORD=$(secret 24)"
      echo "MIRU_SECRET_KEY_BASE=$(secret 64)"
      echo "# The seeded users' password: sign in to the existing application with it."
      echo "MIRU_SEED_PASSWORD=$(secret 16)"
      echo "TIMEKEEPING_DB_PASSWORD=$(secret 24)"
      echo "TIMEKEEPING_SECRET_KEY_BASE=$(secret 64)"
      echo "TIMEKEEPING_TOKEN_KEY=$(secret 32)"
    } > "${ENV_FILE}"
  )
  echo "Wrote the demo's credentials to ${ENV_FILE}."
}

build() {
  local rev
  rev="$(revision)"
  MIRU_REVISION="${rev}" TIMEKEEPING_REVISION="${rev}" compose build "$@"
}

cmd_up() {
  build miru-web timekeeping-web
  compose up --detach --wait "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}"
  cmd_versions
}

# Rebuilds one application's image and restarts its processes on it, leaving
# the other application's containers, and the artifact they run, untouched
# (§11.2, §13 item 4). The web process comes back healthy before its worker.
cmd_rebuild() {
  local web worker
  case "${1:-}" in
    timekeeping) web=timekeeping-web; worker=timekeeping-relay ;;
    existing) web=miru-web; worker=miru-jobs ;;
    *) die "rebuild takes timekeeping or existing" ;;
  esac
  build "${web}"
  compose up --detach --wait --no-deps --force-recreate "${web}"
  compose up --detach --wait --no-deps --force-recreate "${worker}"
  cmd_versions
}

# "<container id> <image id> <revision>" for a service's running process, or
# nothing when it is not running. Each container is inspected by its name,
# and each --format given as one argument.
process_state() {
  local name container image rev
  name="$(compose ps --format '{{.Name}}' "$1")"
  [ -n "${name}" ] || return 0
  container="$(docker inspect --format='{{.Id}}' "${name}")"
  image="$(docker inspect --format='{{.Image}}' "${name}")"
  rev="$(docker image inspect --format='{{index .Config.Labels "org.opencontainers.image.revision"}}' "${image}")"
  echo "${container} ${image} ${rev}"
}

cmd_versions() {
  local service container image rev
  for service in "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}"; do
    read -r container image rev <<< "$(process_state "${service}")"
    if [ -z "${container}" ]; then
      echo "${service} not running"
      continue
    fi
    echo "${service} revision=${rev} image=${image}"
  done
}

# One line per running process: its container, the image it runs and the
# revision that image was built from. Fails when a process is not running.
processes() {
  local service container image rev
  for service in "$@"; do
    read -r container image rev <<< "$(process_state "${service}")"
    [ -n "${container}" ] || die "${service} is not running; start the demo with bin/timekeeping-demo up"
    echo "${service} container=${container} image=${image} revision=${rev}"
  done
}

# The digest of every contract document a running process reads.
contract_digests() {
  compose exec -T "$1" sh -c "cd '$2' && sha256sum *.json"
}

# The contract check of §13 item 4: both running applications read the same
# contract documents, byte for byte, and every contract holds between them
# (bin/rails timekeeping:contract_check, Timekeeping::ContractCheck).
cmd_contract_check() {
  local existing timekeeping
  existing="$(contract_digests miru-web "${EXISTING_CONTRACTS}")"
  timekeeping="$(contract_digests timekeeping-web "${TIMEKEEPING_CONTRACTS}")"
  if [ -z "${existing}" ] || [ "${existing}" != "${timekeeping}" ]; then
    die "$(printf 'the two applications do not read the same contract documents\nexisting application:\n%s\nTimekeeping:\n%s' "${existing}" "${timekeeping}")"
  fi
  echo "contract documents: both applications read the same $(echo "${existing}" | wc -l | tr -d ' ') files"
  compose exec -T miru-web bin/rails timekeeping:contract_check
}

# One deploy of the independent-deployment proof: rebuild and restart one
# application, then prove the other still runs the containers and images it
# ran before, that each of this one's processes was restarted, and that the
# contract check holds.
deploy() {
  local name="$1" other_name before_other after_other before after service
  local -a services others
  case "${name}" in
    timekeeping) services=("${TIMEKEEPING_SERVICES[@]}"); others=("${EXISTING_SERVICES[@]}"); other_name="the existing application" ;;
    existing) services=("${EXISTING_SERVICES[@]}"); others=("${TIMEKEEPING_SERVICES[@]}"); other_name="Timekeeping" ;;
  esac
  echo "== deploy: ${name}, alone ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
  before_other="$(processes "${others[@]}")"
  before="$(processes "${services[@]}")"
  cmd_rebuild "${name}"
  after_other="$(processes "${others[@]}")"
  if [ "${before_other}" != "${after_other}" ]; then
    die "$(printf 'rebuilding %s changed %s\nbefore:\n%s\nafter:\n%s' "${name}" "${other_name}" "${before_other}" "${after_other}")"
  fi
  after="$(processes "${services[@]}")"
  for service in "${services[@]}"; do
    if [ "$(grep "^${service} " <<< "${before}" | cut -d' ' -f2)" = "$(grep "^${service} " <<< "${after}" | cut -d' ' -f2)" ]; then
      die "${service} was not restarted"
    fi
  done
  echo "${name} now runs:"
  echo "${after}"
  echo "${other_name} stayed at its prior artifact:"
  echo "${after_other}"
  cmd_contract_check
}

# The independent-deployment proof of §13 item 4 (§11.2): no paired release.
# The contract check holds first; then Timekeeping is rebuilt and restarted
# while the existing application stays at its prior artifact, and the check
# holds again; then the existing application while Timekeeping stays
# unchanged, and the check holds again. Every version is recorded.
independent_deploys() {
  echo "== before the deploys ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}"
  cmd_contract_check
  deploy timekeeping
  deploy existing
  echo "== independent deploys done: two deploys, one of each application, the contract check green after each"
}

cmd_independent_deploys() {
  local record status
  require_env_file
  mkdir -p "${RECORD_DIR}"
  record="${RECORD_DIR}/$(date -u +%Y%m%dT%H%M%SZ).log"
  # Not as an `if` condition, which would turn off errexit inside it: the
  # first step that fails must end the proof.
  set +e
  (set -e; independent_deploys) 2>&1 | tee "${record}"
  status=$?
  set -e
  echo "Recorded in ${record}."
  return "${status}"
}

# Starts Timekeeping's relay again, and shows it runs.
resume_relay() {
  echo "== resuming Timekeeping's relay"
  compose start timekeeping-relay
  processes timekeeping-relay
}

# The relay-paused proof of §13 item 5 (§12.4), while Timekeeping owns the
# entries: with timekeeping-relay stopped, a new entry is listed and invoiced
# at once and is not projected (bin/rails timekeeping:relay_paused:paused);
# with it started again, the projection catches up
# (timekeeping:relay_paused:resumed). Both halves run in the existing
# application under one run name. The relay is started again however the
# first half ends.
cmd_relay_paused() {
  local run
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  echo "== pausing Timekeeping's relay: run ${run}"
  trap resume_relay EXIT
  compose stop timekeeping-relay
  [ -z "$(process_state timekeeping-relay)" ] || die "timekeeping-relay still runs after it was stopped"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:relay_paused:paused
  trap - EXIT
  resume_relay
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:relay_paused:resumed
  echo "== relay paused: a new entry was listed and invoiced before the relay delivered it, and the projection caught up once it resumed"
}

# Starts a stopped relay's service again, and shows it runs.
resume_service() {
  echo "== resuming $1"
  compose start "$1"
  processes "$1"
}

# The user-hard-delete proof of §12.4, while Timekeeping or the prepared
# application owns the entries: the existing application names the service
# that runs the current owner's relay (timekeeping-relay, or miru-jobs for
# the prepared application's local relay;
# bin/rails timekeeping:user_delete_refused:relay). With it stopped, the
# super-admin delete of a user whose first entry is not yet projected is
# refused with nothing changed (timekeeping:user_delete_refused:paused); with
# it started again, the entry is projected
# (timekeeping:user_delete_refused:resumed). All three run in miru-web under
# one run name. The relay is started again however the first half ends.
cmd_user_delete_refused() {
  local run relay
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  relay="$(compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:user_delete_refused:relay | tail -n 1)"
  case "${relay}" in
    timekeeping-relay|miru-jobs) ;;
    *) die "the existing application named no relay to pause: ${relay:-nothing}" ;;
  esac
  echo "== pausing the owner's relay (${relay}): run ${run}"
  # Expanded now: the trap runs after this function, and its locals, are gone.
  trap "resume_service ${relay}" EXIT
  compose stop "${relay}"
  [ -z "$(process_state "${relay}")" ] || die "${relay} still runs after it was stopped"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:user_delete_refused:paused
  trap - EXIT
  resume_service "${relay}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:user_delete_refused:resumed
  echo "== user delete refused: the super-admin delete of a user with an unprojected first entry was refused, and the entry was projected once ${relay} resumed"
}

# Starts Timekeeping's web process again and waits until it is healthy, then
# shows it runs. Its container is the one that was stopped: nothing is
# rebuilt or recreated.
resume_timekeeping_web() {
  echo "== starting timekeeping-web again"
  compose up --detach --wait --no-deps --no-recreate timekeeping-web
  processes timekeeping-web
}

# The aggregate-line proof of §12.4 (F3), while Timekeeping owns the entries:
# a draft holding a direct line for X and a grouped line for X and Y keeps X
# when the grouped line goes, and releases Y, then X with the direct line
# (bin/rails timekeeping:aggregate_line:held). With timekeeping-web stopped, a
# save and a destroy of the draft fail and leave it as it was
# (timekeeping:aggregate_line:outage); with it started again, every
# reservation held, and destroying the draft releases its whole set
# (timekeeping:aggregate_line:restored). All three run in miru-web under one
# run name. timekeeping-web is started again however the outage step ends.
cmd_aggregate_line() {
  local run
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  echo "== aggregate line: run ${run}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:aggregate_line:held
  echo "== stopping timekeeping-web"
  trap resume_timekeeping_web EXIT
  compose stop timekeeping-web
  [ -z "$(process_state timekeeping-web)" ] || die "timekeeping-web still runs after it was stopped"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:aggregate_line:outage
  trap - EXIT
  resume_timekeeping_web
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:aggregate_line:restored
  echo "== aggregate line: removing a grouped line released only what no other line references, a failed save and destroy kept every reservation, and destroying the draft released its whole set"
}

# The save-failure part of §12.4's failure injection (§9.3), while
# Timekeeping owns the entries: one step in miru-web
# (bin/rails timekeeping:save_failures, Timekeeping::SaveFailuresCheck). It
# puts each failure between the existing application and the running
# Timekeeping itself, and its crash is a child process of that step killing
# itself, so nothing is stopped or started here.
cmd_save_failures() {
  local run
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  echo "== save failures: run ${run}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:save_failures
  echo "== save failures: a lost prepare answer, a crash after prepare and a rolled-back save each ended failed and aborted, and no replay of a resolved operation changed anything"
}

# The reservation-protocol part of §12.4's failure injection (§9.3), while
# Timekeeping owns the entries: with miru-jobs, which runs the invoice
# operation worker, stopped, a wrong-company save is refused, two saves
# behind an unresolved operation are refused as retryable, and every commit
# and abort answer of one in-process sweep is lost
# (bin/rails timekeeping:reservation_failures:paused); with it started again,
# every outcome is delivered, the resent commit changes nothing, and the
# client's retry goes through (timekeeping:reservation_failures:resumed).
# Both run in miru-web under one run name. miru-jobs is started again however
# the first step ends.
cmd_reservation_failures() {
  local run
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  echo "== pausing the invoice operation worker (miru-jobs): run ${run}"
  trap "resume_service miru-jobs" EXIT
  compose stop miru-jobs
  [ -z "$(process_state miru-jobs)" ] || die "miru-jobs still runs after it was stopped"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:reservation_failures:paused
  trap - EXIT
  resume_service miru-jobs
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:reservation_failures:resumed
  echo "== reservation failures: a wrong-company save and the saves behind an unresolved operation were refused, the lost commit was sent again and changed nothing, and the retry went through once miru-jobs resumed"
}

# Where the billing-handoff proof's steps leave their markers, in miru-web
# (the miru_handoff_journals volume; Timekeeping::BillingHandoffCheck).
BILLING_HANDOFF_DIR=tmp/timekeeping/billing-handoff

# Waits until the billing-handoff run's marker is written, while the process
# that writes it still runs. Fails when that process has ended without it, or
# after five minutes.
wait_for_marker() {
  local run="$1" name="$2" pid="$3" deadline=$((SECONDS + 300))
  # In sh -c: docker compose would take a bare -f after the service as its own.
  until compose exec -T miru-web sh -c "test -f '${BILLING_HANDOFF_DIR}/${run}/${name}'"; do
    kill -0 "${pid}" 2>/dev/null || return 1
    [ "${SECONDS}" -lt "${deadline}" ] || return 1
    sleep 0.5
  done
}

# The billing-writes-during-a-handoff proof of §12.4 (§10.1), under any owner
# with admission open: the existing application names the handoff that owner
# hands over with (bin/rails timekeeping:billing_handoff:handoff). A billing
# write is paused inside its transaction (timekeeping:billing_handoff:paused)
# and that handoff is started; the paused step sees the handoff's step 1 wait
# on it. timekeeping-web is stopped before the release, so once the write
# commits, the handoff closes admission and then stops, unable to reach
# Timekeeping, for a resume. While it stands there, billing writes are
# refused with 503 ownership-moving (timekeeping:billing_handoff:refused).
# Then timekeeping-web is started again, the handoff resumed to its end, and
# a payment is accepted again (timekeeping:billing_handoff:resumed). All four
# run in miru-web under one run name; the handoff's own output is shown, and
# kept under tmp/timekeeping-demo/billing-handoff. timekeeping-web is started
# again however the steps between end.
cmd_billing_handoff() {
  local run handoff log writer runner
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  handoff="$(compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:billing_handoff:handoff | tail -n 1)"
  case "${handoff}" in
    timekeeping:first_cutover|timekeeping:rollback|timekeeping:recutover) ;;
    *) die "the existing application named no handoff to run: ${handoff:-nothing}" ;;
  esac
  log="$(dirname "${ENV_FILE}")/billing-handoff/${run}.log"
  mkdir -p "$(dirname "${log}")"
  echo "== billing handoff: run ${run}, handing over with ${handoff}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:billing_handoff:paused &
  writer=$!
  wait_for_marker "${run}" admitted "${writer}" || die "the paused billing write was never admitted"
  echo "== starting ${handoff} while the billing write is paused"
  compose exec -T miru-web bin/rails "${handoff}" > "${log}" 2>&1 &
  runner=$!
  wait_for_marker "${run}" waiting "${writer}" || die "the handoff's step 1 was never seen waiting on the paused billing write"
  echo "== stopping timekeeping-web, so the handoff stops after its step 1"
  trap resume_timekeeping_web EXIT
  compose stop timekeeping-web
  [ -z "$(process_state timekeeping-web)" ] || die "timekeeping-web still runs after it was stopped"
  echo "== releasing the paused billing write"
  compose exec -T miru-web touch "${BILLING_HANDOFF_DIR}/${run}/release"
  wait "${writer}" || die "the paused billing write failed"
  if wait "${runner}"; then
    cat "${log}"
    die "${handoff} finished while timekeeping-web was stopped"
  fi
  cat "${log}"
  grep -q " stopped: " "${log}" || die "${handoff} did not stop for a resume"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:billing_handoff:refused
  trap - EXIT
  resume_timekeeping_web
  echo "== resuming ${handoff}"
  compose exec -T miru-web bin/rails "${handoff}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:billing_handoff:resumed
  echo "== billing handoff: the handoff's step 1 waited for the paused billing write, billing writes were refused with 503 ownership-moving while it ran, and accepted again once it finished"
}

# The hard-delete-of-a-non-draft part of §12.4's failure injection (§9.3,
# §7.3), while Timekeeping or the prepared application owns the entries: one
# step in miru-web (bin/rails timekeeping:hard_delete,
# Timekeeping::HardDeleteCheck). Its failure is the one a user meets, a
# recorded payment refusing the destroy, so nothing is stopped or started.
cmd_hard_delete() {
  local run
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  echo "== hard delete: run ${run}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:hard_delete
  echo "== hard delete: a failed hard delete of a non-draft changed nothing, and a successful one kept the edit lock until a successor took the entry over"
}

# The stale-generation part of §12.4's failure injection (§9.3), while
# Timekeeping owns the entries: one step in miru-web
# (bin/rails timekeeping:stale_generation, Timekeeping::StaleGenerationCheck).
# It sends calls carrying another generation to the running Timekeeping, so
# nothing is stopped or started. The step's output is kept under
# tmp/timekeeping-demo/stale-generation; its last line names the request id
# of every refused call, and each must be in timekeeping-web's log as
# Timekeeping's own stale-generation alert (§11.3).
cmd_stale_generation() {
  local run output ids id logs
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  output="$(dirname "${ENV_FILE}")/stale-generation/${run}.log"
  mkdir -p "$(dirname "${output}")"
  echo "== stale generation: run ${run}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:stale_generation | tee "${output}"
  ids="$(sed -n 's/^stale generation: refused request ids: //p' "${output}" | tail -n 1)"
  [ -n "${ids}" ] || die "the stale-generation step named no refused request"
  logs="$(compose logs --no-color --no-log-prefix timekeeping-web)"
  for id in ${ids}; do
    grep -qF "[${id}] Timekeeping signal stale_generation: " <<< "${logs}" ||
      die "timekeeping-web's log has no stale-generation alert for request ${id} (§11.3)"
  done
  echo "== stale generation: every call carrying another generation was refused and changed nothing, the retries went to the current owner, and Timekeeping reported each of the $(wc -w <<< "${ids}" | tr -d ' ') refusals as an alert"
}

# The mark on the line consumer-down adds to timekeeping-relay's /etc/hosts.
CONSUMER_DOWN_MARK="bin/timekeeping-demo consumer-down"

# Whether timekeeping-relay reaches the projection consumer where it delivers
# (its EXISTING_APP_URL): "reached <status>" for the existing application's
# health check there, or "unreachable <error>".
consumer_probe() {
  compose exec -T timekeeping-relay ruby -rnet/http -e '
    url = URI(ENV.fetch("EXISTING_APP_URL"))
    begin
      response = Net::HTTP.start(url.host, url.port, open_timeout: 5, read_timeout: 5) { |http| http.get("/health") }
      puts "reached #{response.code}"
    rescue SystemCallError, SocketError, IOError, Timeout::Error => error
      puts "unreachable #{error.class}"
    end'
}

# Takes the projection consumer down as timekeeping-relay meets it: inside
# that one container, miru-web names 127.0.0.1, where nothing listens, so
# each delivery is refused at connect, as from a consumer whose process is
# not running. miru-web itself, and every other process, runs on.
take_consumer_down() {
  compose exec -T --user root timekeeping-relay sh -c "printf '127.0.0.1 miru-web # %s\n' '${CONSUMER_DOWN_MARK}' >> /etc/hosts"
}

# Removes that line again; the same relay process reaches miru-web on its
# next run. /etc/hosts is a file Docker mounts, so it is rewritten in place.
bring_consumer_back() {
  echo "== bringing the projection consumer back for timekeeping-relay"
  compose exec -T --user root timekeeping-relay sh -c \
    "grep -vF '${CONSUMER_DOWN_MARK}' /etc/hosts > /tmp/hosts.consumer-up; cat /tmp/hosts.consumer-up > /etc/hosts; rm -f /tmp/hosts.consumer-up"
}

# How many of timekeeping-relay's deliveries were refused at connect since
# $1 (OutboxRelay logs each batch it could not deliver as "relay: relay <id>:
# <error>").
refused_deliveries() {
  compose logs --no-color --no-log-prefix --since "$1" timekeeping-relay | grep -c 'relay: relay .*Errno::ECONNREFUSED' || true
}

# The number of outbox positions Timekeeping's signals count undelivered.
# Fails when they report an alert.
undelivered_positions() {
  local signals
  signals="$(compose exec -T timekeeping-web bin/rails timekeeping:signals)" || die "Timekeeping's signals report an alert: ${signals}"
  echo "${signals}" >&2
  sed -n 's/^relay lag: .* s, \([0-9][0-9]*\) position(s) undelivered.*/\1/p' <<< "${signals}"
}

# The projection-consumer-down part of §12.4's failure injection (§9.3),
# while Timekeeping owns the entries: with the consumer up, entry X is
# projected (bin/rails timekeeping:consumer_down:projected). Then the
# consumer is taken down as timekeeping-relay meets it while the relay keeps
# running: X is edited and a new entry Y written, both are listed and
# invoiced at once, and the projection stays as it was
# (timekeeping:consumer_down:down), while the relay's log shows its
# deliveries refused and Timekeeping's signals count the snapshots still
# undelivered. Then the consumer is brought back, with no process restarted,
# and the same relay's resend brings the projection to Timekeeping's
# versions (timekeeping:consumer_down:restored), with nothing left
# undelivered. All three run in miru-web under one run name. The consumer is
# brought back however the down step ends.
cmd_consumer_down() {
  local run before after probe since refused undelivered
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  echo "== consumer down: run ${run}"
  probe="$(consumer_probe)"
  [ "${probe}" = "reached 200" ] || die "timekeeping-relay does not reach the projection consumer before the run: ${probe:-no answer}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:consumer_down:projected
  before="$(processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}")"

  echo "== taking the projection consumer down for timekeeping-relay, which keeps running"
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  trap bring_consumer_back EXIT
  take_consumer_down
  probe="$(consumer_probe)"
  case "${probe}" in
    "unreachable "*) echo "timekeeping-relay: the projection consumer is ${probe}" ;;
    *) die "timekeeping-relay still reaches the projection consumer after it was taken down: ${probe:-no answer}" ;;
  esac
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:consumer_down:down
  refused="$(refused_deliveries "${since}")"
  [ "${refused}" -ge 2 ] || die "timekeeping-relay's log shows ${refused} refused deliveries while the consumer was down, not the retries of §9.3"
  echo "timekeeping-relay: ${refused} deliveries refused while the consumer was down"
  undelivered="$(undelivered_positions)"
  [ "${undelivered:-0}" -gt 0 ] || die "Timekeeping counts no snapshot undelivered while the consumer is down"
  trap - EXIT
  bring_consumer_back
  probe="$(consumer_probe)"
  [ "${probe}" = "reached 200" ] || die "timekeeping-relay does not reach the projection consumer after it was brought back: ${probe:-no answer}"
  after="$(processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}")"
  if [ "${before}" != "${after}" ]; then
    die "$(printf 'a process was restarted while the consumer was down\nbefore:\n%s\nafter:\n%s' "${before}" "${after}")"
  fi

  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:consumer_down:restored
  undelivered="$(undelivered_positions)"
  [ "${undelivered}" = 0 ] || die "Timekeeping still counts ${undelivered:-an unknown number of} snapshots undelivered after the consumer came back"
  echo "== consumer down: entries were listed and invoiced at once while the relay's ${refused} deliveries were refused, and once the consumer was back the same relay delivered every snapshot and the projection holds Timekeeping's versions"
}

# Waits until Timekeeping's signals count no outbox position undelivered, for
# at most CHECK_WAIT seconds (60 by default).
wait_until_delivered() {
  local undelivered deadline=$((SECONDS + ${CHECK_WAIT:-60}))
  while :; do
    undelivered="$(undelivered_positions)"
    [ "${undelivered}" != 0 ] || return 0
    [ "${SECONDS}" -lt "${deadline}" ] || die "Timekeeping still counts ${undelivered:-an unknown number of} snapshots undelivered ${CHECK_WAIT:-60} s after the relay started"
    sleep 1
  done
}

# The duplicate-and-reordered-delivery part of §13 item 6, while Timekeeping
# owns the entries: with the relay running, entry X is projected
# (bin/rails timekeeping:redelivery:projected). Then timekeeping-relay is
# stopped: X is edited twice, Y written and edited, both reserved by a draft,
# and the projection stays behind (timekeeping:redelivery:held, whose last
# line names the entries). In timekeeping-web, Timekeeping resends those
# entries' outbox snapshots through its relay's own call, newest first, then
# each older one alone, then all of them again, and checks each receipt: the
# newest applied, every other ignored (bin/rails timekeeping:redeliver,
# OutboxRedelivery). The projection then holds both as Timekeeping does,
# with the relay still stopped (timekeeping:redelivery:reordered), and the
# outbox still counts them undelivered. Then the relay is started, delivers
# every one of them a second time, and the projection is unchanged
# (timekeeping:redelivery:duplicated). The miru-web steps run under one run
# name. The relay is started again however the steps between end. The
# output is kept under tmp/timekeeping-demo/redelivery.
cmd_redelivery() {
  local run output ids held left
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  output="$(dirname "${ENV_FILE}")/redelivery/${run}.log"
  mkdir -p "$(dirname "${output}")"
  echo "== redelivery: run ${run}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:redelivery:projected | tee "${output}"

  echo "== stopping Timekeeping's relay"
  trap resume_relay EXIT
  compose stop timekeeping-relay
  [ -z "$(process_state timekeeping-relay)" ] || die "timekeeping-relay still runs after it was stopped"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:redelivery:held | tee -a "${output}"
  ids="$(sed -n 's/^redelivery: entries: //p' "${output}" | tail -n 1)"
  [ -n "${ids}" ] || die "the held step named no entry"
  held="$(undelivered_positions)"
  [ "${held:-0}" -gt 0 ] || die "Timekeeping counts no snapshot undelivered while its relay is stopped"

  echo "== Timekeeping resends the snapshots of entries ${ids}: newest first, then each older one, then all again"
  compose exec -T --env "ENTRIES=${ids}" timekeeping-web bin/rails timekeeping:redeliver | tee -a "${output}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:redelivery:reordered | tee -a "${output}"
  left="$(undelivered_positions)"
  [ "${left:-0}" -ge "${held}" ] || die "Timekeeping counts ${left:-no} snapshots undelivered after the resend, fewer than the ${held} before it, so the resend marked the outbox"

  trap - EXIT
  resume_relay
  wait_until_delivered
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:redelivery:duplicated | tee -a "${output}"
  echo "== redelivery: the projection applied only each entry's newest snapshot when they arrived out of order, and the relay's second delivery of all ${left} changed nothing"
}

# The log line of a single-writer guard violation (Timekeeping::Signals,
# Timekeeping::SingleWriterWatch).
SINGLE_WRITER_ALERT="Timekeeping signal single_writer: "

# §13 item 7, under any owner with admission open, in one step: on both
# seeded businesses, neither can read, write, prepare or project the other's
# entries, and inside each the employee cannot touch the admin's entries
# while the admin's web edit of the employee's goes through
# (bin/rails timekeeping:tenant_isolation, Timekeeping::TenantIsolationCheck,
# which also counts the single-writer violations its own process reports).
# Then the single-writer guard must pass in the existing application's other
# processes too: neither miru-web's nor miru-jobs' log may hold a violation,
# since its container started. Nothing is stopped or started. The output is
# kept under tmp/timekeeping-demo/tenant-isolation.
cmd_tenant_isolation() {
  local run output service violations
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  output="$(dirname "${ENV_FILE}")/tenant-isolation/${run}.log"
  mkdir -p "$(dirname "${output}")"
  echo "== tenant isolation: run ${run}"
  compose exec -T --env "RUN=${run}" miru-web bin/rails timekeeping:tenant_isolation | tee "${output}"
  for service in "${EXISTING_SERVICES[@]}"; do
    violations="$(compose logs --no-color --no-log-prefix "${service}" | grep -F "${SINGLE_WRITER_ALERT}" || true)"
    if [ -n "${violations}" ]; then
      printf '%s\n' "${violations}" | tee -a "${output}" >&2
      die "${service}'s log holds $(wc -l <<< "${violations}" | tr -d ' ') single-writer guard violations (§12.2, §11.3)"
    fi
  done
  echo "== tenant isolation: neither business could reach the other's entries, the ownership guards held on both, and no process of the existing application logged a single-writer guard violation"
}

# Where the interrupted-handoff proof's steps keep their state, in miru-web
# (the miru_handoff_journals volume; Timekeeping::InterruptedHandoffCheck).
INTERRUPTED_HANDOFF_DIR=tmp/timekeeping/interrupted-handoff

# How long, in seconds, the handoff's transfer waits for the stopped relay:
# long for the run the proof kills, so it still waits when it is killed, and
# short for the run that must stop there on its own.
INTERRUPTED_HANDOFF_KILLED_DRAIN=600
INTERRUPTED_HANDOFF_STOPPED_DRAIN=5

# Kills the handoff run the interrupted-handoff proof started in the
# background, if it still runs, so a proof that fails never leaves it to
# finish the handoff on its own once the relay is started again.
stop_interrupted_runner() {
  compose exec -T miru-web sh -c \
    "pid='${INTERRUPTED_HANDOFF_DIR}/$1/runner.pid'; if [ -f \"\$pid\" ]; then kill -KILL \"\$(cat \"\$pid\")\" 2>/dev/null; rm -f \"\$pid\"; fi; true"
}

# One step of the interrupted-handoff proof, in miru-web.
interrupted_handoff_step() {
  compose exec -T --env "RUN=$1" miru-web bin/rails "timekeeping:interrupted_handoff:$2"
}

# The interrupted-and-resumed-handoff part of §13 item 6 (§10.5), under any
# owner with admission open: the existing application names the handoff that
# owner hands over with, and the service that runs the relay its transfer
# waits on (bin/rails timekeeping:interrupted_handoff:plan). With that relay
# running, entry X is written and reserved by a draft (:held); with it
# stopped, entry Y is written (:paused). Then the handoff is interrupted
# twice in its transfer, which cannot finish while the relay is stopped.
# First it runs in the background, with its drain timeout raised, and once it
# stands in its transfer (:transferring) its process is killed with SIGKILL:
# still fenced, nothing changed, writes refused (:crashed). Then it runs again
# with a short drain timeout and stops there for a resume: the same, with the
# journal the killed run left reused (:timed_out). Last, the relay is started
# again and the handoff resumed to its end, with money, entries and
# reservations kept, and writes accepted again (:resumed). Every step runs in
# miru-web under one run name; each handoff run's own output is shown, and
# kept under tmp/timekeeping-demo/interrupted-handoff. The relay is started
# again, and a background run killed, however the steps between end.
cmd_interrupted_handoff() {
  local run plan handoff relay output runner
  require_env_file
  processes "${EXISTING_SERVICES[@]}" "${TIMEKEEPING_SERVICES[@]}" > /dev/null
  run="$(date -u +%Y%m%dT%H%M%SZ)-$(secret 2)"
  plan="$(interrupted_handoff_step "${run}" plan | tail -n 1)"
  read -r handoff relay <<< "${plan}"
  case "${handoff} ${relay}" in
    "timekeeping:first_cutover timekeeping-relay"|"timekeeping:rollback timekeeping-relay"|"timekeeping:recutover miru-jobs") ;;
    *) die "the existing application named no handoff and relay to interrupt: ${plan:-nothing}" ;;
  esac
  output="$(dirname "${ENV_FILE}")/interrupted-handoff/${run}"
  mkdir -p "${output}"
  echo "== interrupted handoff: run ${run}, handing over with ${handoff}, whose transfer waits on ${relay}"
  interrupted_handoff_step "${run}" held
  echo "== stopping ${relay}"
  # Expanded now: the trap runs after this function, and its locals, are gone.
  trap "stop_interrupted_runner ${run}; resume_service ${relay}" EXIT
  compose stop "${relay}"
  [ -z "$(process_state "${relay}")" ] || die "${relay} still runs after it was stopped"
  interrupted_handoff_step "${run}" paused

  echo "== first interruption: starting ${handoff}, and killing it with SIGKILL in its transfer"
  # sh's own pid is the handoff's: exec runs it in sh's place.
  compose exec -T --env "DRAIN_TIMEOUT=${INTERRUPTED_HANDOFF_KILLED_DRAIN}" miru-web \
    sh -c "echo \$\$ > '${INTERRUPTED_HANDOFF_DIR}/${run}/runner.pid' && exec bin/rails ${handoff}" \
    > "${output}/killed.log" 2>&1 &
  runner=$!
  interrupted_handoff_step "${run}" transferring
  stop_interrupted_runner "${run}"
  trap "resume_service ${relay}" EXIT
  if wait "${runner}"; then
    cat "${output}/killed.log"
    die "${handoff} finished, though it was killed"
  fi
  cat "${output}/killed.log"
  if grep -q "done at generation\| stopped: " "${output}/killed.log"; then
    die "${handoff} ended on its own before it was killed"
  fi
  interrupted_handoff_step "${run}" crashed

  echo "== second interruption: running ${handoff} again, with ${relay} still stopped, until its transfer gives up"
  if compose exec -T --env "DRAIN_TIMEOUT=${INTERRUPTED_HANDOFF_STOPPED_DRAIN}" miru-web bin/rails "${handoff}" \
    > "${output}/stopped.log" 2>&1; then
    cat "${output}/stopped.log"
    die "${handoff} finished while ${relay} was stopped"
  fi
  cat "${output}/stopped.log"
  grep -q " stopped: .*DrainTimeout" "${output}/stopped.log" || die "${handoff} did not stop in its transfer for a resume"
  interrupted_handoff_step "${run}" timed_out

  trap - EXIT
  resume_service "${relay}"
  echo "== resuming ${handoff} to its end"
  compose exec -T miru-web bin/rails "${handoff}" 2>&1 | tee "${output}/resumed.log"
  grep -q "done at generation" "${output}/resumed.log" || die "${handoff} did not finish when resumed"
  interrupted_handoff_step "${run}" resumed
  echo "== interrupted handoff: ${handoff} was killed in its transfer and then stopped there for a resume, stayed fenced and changed nothing each time, and resumed to its end with money, entries and reservations kept"
}

cmd_handoff() {
  case "${1:-}" in
    first_cutover|first_cutover:abort|rollback|rollback:abort|recutover|recutover:abort) ;;
    *) die "handoff takes first_cutover, rollback or recutover, each with an optional :abort" ;;
  esac
  compose exec miru-web bin/rails "timekeeping:$1"
}

cmd_journey() {
  compose exec miru-web bin/rails timekeeping:journey
}

cmd_alternating_writers() {
  compose exec miru-web bin/rails timekeeping:alternating_writers
}

# Both copies of the ownership record, and last the owner, generation and
# state they agree on (bin/rails timekeeping:ownership).
cmd_ownership() {
  compose exec -T miru-web bin/rails timekeeping:ownership
}

# The fresh demo reset of §10.1: both databases and the handoff journals are
# deleted, and the next start reseeds the two businesses in the initial
# legacy state.
cmd_reset() {
  echo "== reset: deleting both databases and the handoff journals, then starting a freshly seeded demo"
  compose down --volumes
  cmd_up
}

# The acceptance run of §13: every item green on one local run. Each line is
# "<owner generation state the step starts under>|<command>|<what it proves>".
# A reset needs no owner. The journey and the alternating-writers proof each
# start from a fresh demo and run all three handoffs themselves, so each has
# a pass of its own. The first pass visits every owner through the handoffs
# of the billing-handoff and interrupted-handoff proofs, and runs each
# owner's proofs under it. It never hands over a fourth time: a second
# rollback needs a reset first (Timekeeping::Rollback).
ACCEPTANCE_STEPS=(
  "|reset|"
  "legacy 0 open|tenant-isolation|§13.7"
  "legacy 0 open|billing-handoff|§12.4 §13.2 §10.4"
  "timekeeping 1 open|tenant-isolation|§13.7"
  "timekeeping 1 open|independent-deploys|§13.4"
  "timekeeping 1 open|relay-paused|§13.5 §12.4"
  "timekeeping 1 open|aggregate-line|§12.4 §13.6"
  "timekeeping 1 open|save-failures|§12.4 §13.6"
  "timekeeping 1 open|reservation-failures|§12.4 §13.6"
  "timekeeping 1 open|stale-generation|§12.4 §13.6"
  "timekeeping 1 open|consumer-down|§12.4 §13.6"
  "timekeeping 1 open|redelivery|§13.6"
  "timekeeping 1 open|hard-delete|§12.4 §13.6"
  "timekeeping 1 open|user-delete-refused|§12.4"
  "timekeeping 1 open|interrupted-handoff|§13.6 §13.2 §13.3 §10.4"
  "monolith 2 open|tenant-isolation|§13.7"
  "monolith 2 open|hard-delete|§12.4 §13.6"
  "monolith 2 open|user-delete-refused|§12.4"
  "monolith 2 open|interrupted-handoff|§13.6 §13.2 §13.3 §10.4"
  "timekeeping 3 open|tenant-isolation|§13.7"
  "timekeeping 3 open|contract-check|§13.4"
  "|reset|"
  "legacy 0 open|journey|§13.1 §13.2 §13.3 §10.4"
  "timekeeping 3 open|contract-check|§13.4"
  "|reset|"
  "legacy 0 open|alternating-writers|§12.4 §13.2 §10.4"
  "timekeeping 3 open|tenant-isolation|§13.7"
)
# Where the run's last step must leave the demo.
ACCEPTANCE_END="timekeeping 3 open"

# What each item the run reports on is, as §13, §12.4 and §10.4 name it.
ACCEPTANCE_ITEMS=(
  "§13.1|the journey, end to end, on both tenants"
  "§13.2|financial parity by snapshot, around every handoff"
  "§13.3|rollback and re-cutover keep every write, reservation owner and receipt"
  "§13.4|independent deployment, the contract check green after each deploy"
  "§13.5|relay paused"
  "§13.6|failure cases"
  "§13.7|tenant isolation, ownership guards, the single-writer guard"
  "§12.4|integration: every proof the section lists"
  "§10.4|reconciliation and money checks across cutover, rollback and re-cutover"
)

# The command each acceptance step runs: this script, each step in its own
# process, so a proof's own exit and cleanup end only that proof.
# TIMEKEEPING_DEMO_SELF names a stand-in for the specs.
SELF="${TIMEKEEPING_DEMO_SELF:-${BASH_SOURCE[0]}}"

# The owner, generation and state both copies agree on, as the last line of
# `ownership`; nothing when they cannot be read or differ, which
# `ownership` says on stderr.
acceptance_owner() {
  local lines
  lines="$("${SELF}" ownership)" || return 0
  printf '%s\n' "${lines}" | sed '$!d'
}

# Runs the steps in order, each recorded with its result and time, until the
# first that fails: every later step depends on the state the earlier ones
# leave. Fills RESULTS, one per step: pass, FAIL or "not run".
acceptance_steps() {
  local index expected command proves owner started status
  for index in "${!ACCEPTANCE_STEPS[@]}"; do
    RESULTS[index]="not run"
  done
  for index in "${!ACCEPTANCE_STEPS[@]}"; do
    IFS='|' read -r expected command proves <<< "${ACCEPTANCE_STEPS[index]}"
    echo
    echo "== acceptance step $((index + 1))/${#ACCEPTANCE_STEPS[@]}: ${command}${proves:+ (${proves})} ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
    if [ -n "${expected}" ]; then
      owner="$(acceptance_owner)"
      echo "ownership: ${owner:-unreadable}"
      if [ "${owner}" != "${expected}" ]; then
        echo "acceptance: ${command} starts under ${expected}, but the demo stands under ${owner:-an ownership record that cannot be read}" >&2
        RESULTS[index]=FAIL
        return 1
      fi
    fi
    started="${SECONDS}"
    status=0
    "${SELF}" "${command}" || status=$?
    if [ "${status}" -ne 0 ]; then
      echo "acceptance: ${command} exited ${status}" >&2
      RESULTS[index]=FAIL
      return 1
    fi
    RESULTS[index]="pass $((SECONDS - started)) s"
  done
  owner="$(acceptance_owner)"
  echo "ownership at the end: ${owner:-unreadable}"
  if [ "${owner}" != "${ACCEPTANCE_END}" ]; then
    echo "acceptance: the run ends under ${owner:-an ownership record that cannot be read}, not ${ACCEPTANCE_END}" >&2
    return 1
  fi
}

# The run's summary: every step with its result, then each item green only
# when every step that proves it passed.
acceptance_summary() {
  local index expected command proves item name steps green
  echo
  echo "== acceptance summary"
  for index in "${!ACCEPTANCE_STEPS[@]}"; do
    IFS='|' read -r expected command proves <<< "${ACCEPTANCE_STEPS[index]}"
    printf '%2d  %-20s  %-22s  %s\n' "$((index + 1))" "${expected:--}" "${command}" "${RESULTS[index]}"
  done
  echo
  for item in "${ACCEPTANCE_ITEMS[@]}"; do
    IFS='|' read -r name item <<< "${item}"
    steps=""
    green=1
    for index in "${!ACCEPTANCE_STEPS[@]}"; do
      IFS='|' read -r expected command proves <<< "${ACCEPTANCE_STEPS[index]}"
      case " ${proves} " in
        *" ${name} "*)
          steps="${steps:+${steps}, }$((index + 1)) ${command}"
          [ "${RESULTS[index]%% *}" = pass ] || green=0
          ;;
      esac
    done
    printf '%-6s %-6s %s: steps %s\n' "${name}" "$([ "${green}" = 1 ] && echo green || echo NOT)" "${item}" "${steps}"
  done
}

acceptance() {
  local status=0
  local -a RESULTS=()
  echo "== acceptance run of docs/architecture/timekeeping-soa.md §13 on the local demo, revision $(revision) ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
  # Every failure in the steps is handled there and ends them with 1.
  acceptance_steps || status=$?
  acceptance_summary
  if [ "${status}" -ne 0 ]; then
    echo "== acceptance: FAILED; the steps after the one that failed did not run"
    return 1
  fi
  echo "== acceptance: every item of §13 green on one local run, from three fresh demos"
}

# §13 on one local run (§11.2): three passes, each from a fresh demo reset,
# that run every proof of §13 and §12.4 in the order of ACCEPTANCE_STEPS,
# each under the owner it needs, checked on both copies before it starts.
# It deletes the demo's databases, so it runs only when asked with --reset.
# The whole run is written to tmp/timekeeping-demo/acceptance/<UTC time>.log
# (TIMEKEEPING_DEMO_ACCEPTANCE_DIR to keep it elsewhere).
cmd_acceptance() {
  local dir record status
  [ "${1:-}" = --reset ] || die "acceptance resets the demo three times, deleting both databases and the handoff journals; run it as: bin/timekeeping-demo acceptance --reset"
  require_env_file
  dir="${TIMEKEEPING_DEMO_ACCEPTANCE_DIR:-$(dirname "${ENV_FILE}")/acceptance}"
  mkdir -p "${dir}"
  record="${dir}/$(date -u +%Y%m%dT%H%M%SZ).log"
  set +e
  acceptance 2>&1 | tee "${record}"
  status=$?
  set -e
  echo "Recorded in ${record}."
  return "${status}"
}

case "${1:-}" in
  init) cmd_init ;;
  up) cmd_up ;;
  rebuild) shift; cmd_rebuild "$@" ;;
  versions) cmd_versions ;;
  handoff) shift; cmd_handoff "$@" ;;
  journey) cmd_journey ;;
  alternating-writers) cmd_alternating_writers ;;
  contract-check) cmd_contract_check ;;
  independent-deploys) cmd_independent_deploys ;;
  relay-paused) cmd_relay_paused ;;
  user-delete-refused) cmd_user_delete_refused ;;
  aggregate-line) cmd_aggregate_line ;;
  billing-handoff) cmd_billing_handoff ;;
  save-failures) cmd_save_failures ;;
  reservation-failures) cmd_reservation_failures ;;
  hard-delete) cmd_hard_delete ;;
  stale-generation) cmd_stale_generation ;;
  consumer-down) cmd_consumer_down ;;
  redelivery) cmd_redelivery ;;
  tenant-isolation) cmd_tenant_isolation ;;
  interrupted-handoff) cmd_interrupted_handoff ;;
  ownership) cmd_ownership ;;
  reset) cmd_reset ;;
  acceptance) shift; cmd_acceptance "$@" ;;
  down) compose down ;;
  compose) shift; compose "$@" ;;
  ""|help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
