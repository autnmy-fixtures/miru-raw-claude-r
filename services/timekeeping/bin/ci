#!/usr/bin/env bash
# Timekeeping's own CI (docs/architecture/timekeeping-soa.md §12.3: "provider
# tests run against the schema in Timekeeping's CI"; §14 "Deployment and
# runtime": the second image and its CI build job). Timekeeping has its own
# bundle, so the existing application's CI (bin/parallel_test) never runs it.
# Each step runs the same on a developer machine as in a CI job:
#
#   services/timekeeping/bin/ci tests
#       This service's suite, the contract provider tests included, on its own
#       test database (DB_HOST, DB_USER and DB_PASS, as for bin/rails).
#
#   services/timekeeping/bin/ci image
#       Builds this service's image from the repository root, as the local
#       demo builds it, with the commit as REVISION, and checks the revision
#       it records. Then boots it on TIMEKEEPING_CI_DATABASE_URL, an empty
#       Postgres database the Docker host reaches, with throwaway credentials:
#       the web process must migrate it and answer GET /up, and the relay's
#       worker must start. Both containers are removed when it ends.
#
# REVISION defaults to the checkout's commit, IMAGE to timekeeping:ci-REVISION
# and PORT to 3100. Credentials never sit in a checked-in file (§11.2).
set -euo pipefail

SERVICE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="$(cd "${SERVICE_DIR}/../.." && pwd)"

WEB=timekeeping-ci-web
RELAY=timekeeping-ci-relay
UP_ATTEMPTS="${UP_ATTEMPTS:-60}"

usage() {
  # The comment block at the top of this file, up to its first code line.
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

die() {
  echo "ci: $*" >&2
  exit 1
}

cmd_tests() {
  cd "${SERVICE_DIR}"
  RAILS_ENV=test bin/rails db:prepare
  RAILS_ENV=test bundle exec rspec
}

running() {
  [ "$(docker inspect --format '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]
}

cmd_image() {
  local revision image port env_file label
  [ -n "${TIMEKEEPING_CI_DATABASE_URL:-}" ] || die "set TIMEKEEPING_CI_DATABASE_URL to an empty Postgres database the Docker host reaches"
  revision="${REVISION:-$(git -C "${ROOT}" rev-parse HEAD)}"
  image="${IMAGE:-timekeeping:ci-${revision}}"
  port="${PORT:-3100}"

  # From the repository root: the image holds this service and
  # packages/timekeeping_reservations, and nothing of the existing
  # application. The build fails if the application does not boot in
  # production.
  docker build --file "${ROOT}/services/timekeeping/Dockerfile" --build-arg REVISION="${revision}" --tag "${image}" "${ROOT}"

  label="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "${image}")"
  echo "${image} org.opencontainers.image.revision=${label}"
  [ "${label}" = "${revision}" ] || die "the image records revision ${label}, not ${revision}"

  env_file="$(mktemp)"
  # shellcheck disable=SC2064 # the names are fixed now, on purpose.
  trap "docker rm --force ${WEB} ${RELAY} >/dev/null 2>&1 || true; rm -f '${env_file}'" EXIT
  chmod 600 "${env_file}"
  {
    echo "DATABASE_URL=${TIMEKEEPING_CI_DATABASE_URL}"
    echo "SECRET_KEY_BASE=$(od -An -N64 -tx1 /dev/urandom | tr -d ' \n')"
    echo "TIMEKEEPING_TOKEN_KEY=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    echo "EXISTING_APP_URL=http://127.0.0.1:3000"
    echo "PORT=${port}"
  } > "${env_file}"

  # The default command: the entrypoint migrates, then Puma serves.
  docker run --detach --name "${WEB}" --network host --env-file "${env_file}" "${image}" >/dev/null
  local attempt=0
  until curl -fsS "http://127.0.0.1:${port}/up" >/dev/null; do
    attempt=$((attempt + 1))
    if ! running "${WEB}" || [ "${attempt}" -ge "${UP_ATTEMPTS}" ]; then
      docker logs "${WEB}" || true
      die "the web process did not answer GET /up"
    fi
    sleep 2
  done
  echo "${WEB} answers GET /up"

  docker exec "${WEB}" bin/rails runner \
    'context = ActiveRecord::Base.connection_pool.migration_context; abort("pending migrations") if context.needs_migration?; puts "schema at #{context.current_version}"' \
    || die "the web process left the database unmigrated"

  docker run --detach --name "${RELAY}" --network host --env-file "${env_file}" "${image}" bin/rails solid_queue:start >/dev/null
  sleep 15
  if ! running "${RELAY}"; then
    docker logs "${RELAY}" || true
    die "the relay's worker did not stay up"
  fi
  echo "${RELAY} is running"
}

case "${1:-}" in
  tests) cmd_tests ;;
  image) cmd_image ;;
  ""|help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
