# frozen_string_literal: true

# Timekeeping, the service of docs/architecture/timekeeping-soa.md §11.1. It has
# its own bundle, so it builds and restarts without the existing application's
# (§13 item 4). Versions follow the root Gemfile.lock.
source "https://rubygems.org"

ruby "4.0.1"

gem "actionpack", "~> 8.1.3"
gem "activerecord", "~> 8.1.3"
gem "railties", "~> 8.1.3"

gem "pg", "~> 1.4"
gem "puma", ">= 7.2"

# Every request is checked against the shared contracts (§5), and the user
# token (§6.1) is a JWT; both as in the existing application.
gem "json_schemer", "~> 2.5"
gem "jwt", "~> 3.2"

group :test do
  gem "rspec-rails", "~> 8.0"
end
